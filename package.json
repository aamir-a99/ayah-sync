{
  "name": "ayah-sync",
  "version": "0.1.1",
  "description": "Follows Quran recitation videos with translations using browser CPU recognition or the local GPU helper.",
  "type": "module",
  "scripts": {
    "fetch-data": "node scripts/fetch-quran-data.mjs",
    "fetch-fonts": "node scripts/fetch-fonts.mjs",
    "fetch-translations": "node scripts/fetch-translations.mjs",
    "dev": "vite",
    "prepare-browser-runtime": "node scripts/prepare-browser-runtime.mjs",
    "test:local": "node scripts/test-local-matcher.mjs",
    "test:capture": "node scripts/test-local-capture.mjs",
    "test:threads": "node scripts/test-cpu-threads.mjs",
    "test:lookahead": "node scripts/test-cpu-lookahead.mjs",
    "build": "npm run prepare-browser-runtime && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "puppeteer-core": "^25.13.0",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0"
  }
}
